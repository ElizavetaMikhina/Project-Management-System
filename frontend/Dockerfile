# Используем официальный образ Node.js с версией 23 на основе slim
FROM node:23-slim	

# Устанавливаем рабочую директорию для приложения внутри контейнера
WORKDIR /app

# Копируем yarn.lock и/или package.json
COPY package.json yarn.lock ./

# Устанавливаем зависимости
RUN npm install 

# Копируем все остальные файлы приложения в рабочую директорию контейнера
COPY . .

# Строим приложение для продакшн-среды
RUN npm run build

# Открываем порт 5173 для доступа к приложению через веб-браузер
EXPOSE 5173

# Запускаем приложение с помощью команды yarn start
CMD ["yarn", "start"]